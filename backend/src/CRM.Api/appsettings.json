  // ARMED for the go-live changeover, at the platform owner's request.
  //
  // On the next start this empties the database of all demo and test data and leaves exactly one
  // account: the SuperAdmin below, invited by email and required to enrol in two-factor auth. A
  // verified snapshot is written next to the database first, and the reset abandons itself if that
  // snapshot cannot be taken.
  //
  // DISARM THIS (Reset: false, ConfirmPhrase: "") once it has run. A marker row in the database
  // already stops it repeating, but that marker does not exist in the pre-go-live snapshot — so
  // restoring that snapshot onto a still-armed installation would wipe it a second time.
  "GoLive": {
    "Reset": true,
    "ConfirmPhrase": "DELETE-ALL-DATA-AND-GO-LIVE",
    "SuperAdminEmail": "muhammadakashllc01@gmail.com",
    "SuperAdminName": "Muhammad Akash"
  },

  "Ai": {
    "Provider": "Stub",
    "BaseUrl": "https://api.openai.com",
