<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <!-- Transitive pin: Swashbuckle/AspNetCore.OpenApi pull Microsoft.OpenApi 2.4.1
         (GHSA-v5pm-xwqc-g5wc, High), whose fix landed later in the 2.x line. 2.11.0 is
         the patched build; stay on 2.x for Swashbuckle compat. Remove once the parents bump it. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <!-- Redis backplane for multi-instance SignalR scale-out. Wired only when
         SignalR:Backplane=Redis in configuration; otherwise the package is unused.
         (The SignalR server itself ships in the ASP.NET Core shared framework — no package needed.) -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.0" />
    <!-- Transitive pin: SignalR.StackExchangeRedis pulls MessagePack 2.5.187
         (GHSA-hv8m-jj95-wg3x, High). 2.5.302 is the patched 2.5.x build — stays on the
         2.5 line the Redis backplane expects, avoiding the 3.x breaking changes. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CRM.Application\CRM.Application.csproj" />
    <ProjectReference Include="..\CRM.Infrastructure\CRM.Infrastructure.csproj" />
  </ItemGroup>

</Project>
